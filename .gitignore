# dependencies
node_modules/

# Per-machine runtime state: snapshot history, tags, archived saves.
#
# Anchored to the repo root on purpose. Unanchored, `store/` also matches
# `src/store/`, which quietly kept the whole history-store module out of the
# repository — a clean clone could not start, because scripts/serve.ts imports
# it. Keep the leading slash on anything that names a top-level directory.
/store/
/snapshots/

# fetched at the user's request, never distributed (see README disclaimers)
/data/faces/

# local AI-provider config would hold an API key (planned feature, docs/ai-features.md)
/config/ai.json

# editor and OS noise
.vscode/
Thumbs.db
Desktop.ini
*.log

# planned-feature spec kept local
docs/ai-features.md

# personal save-file exports (DB Browser scratch)
/exports/

# living working notes, local only
spec.md
/old/
